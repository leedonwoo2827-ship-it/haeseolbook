{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "youtube"],
    "baseUrl": ".",
    "paths": { "@hsb/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
